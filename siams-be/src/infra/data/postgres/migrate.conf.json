{
  "dev": {
    "driver": "sqlite3",
    "filename": "~/dev.db"
  },
  "prod": {
    "host": {
      "ENV": "POSTGRES_HOST"
    },
    "port": {
      "ENV": "POSTGRES_PORT"
    },
    "user": {
      "ENV": "POSTGRES_USER"
    },
    "password": {
      "ENV": "POSTGRES_PASS"
    },
    "database": {
      "ENV": "POSTGRES_DB"
    },
    "driver": "pg",
    "multipleStatements": true
  }
}

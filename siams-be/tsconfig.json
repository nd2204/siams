{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "outDir": "./build",
    "rootDir": "./src",
    "baseUrl": "./",
    "paths": {
      "@/*": ["./src/*"],
      "@domain/*": ["./src/domain/*"],
      "@shared/*": ["./src/shared/*"],
      "@application/*": ["./src/application/*"],
      "@adapters/*": ["./src/adapters/*"],
    },
    "strict": false,
    "esModuleInterop": true,
    "strictNullChecks": true,
     // Enables source maps for easier debugging.
    "sourceMap": true
  },
  "include": ["./src/**/*"],
  "exclude": ["build", "dist"]
}

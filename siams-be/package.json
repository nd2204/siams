{
  "name": "siams-be",
  "version": "1.0.0",
  "description": "the backend for siams",
  "license": "MIT",
  "author": "nd2204",
  "type": "commonjs",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start:prod": "node --env-file .env.prod build/index.js",
    "start:dev": "node --env-file .env build/index.js",
    "start": "npm run build && npm run start:prod",
    "dev": "nodemon --watch ./src --exec \"npm run build && npm run start:dev\"",
    "build": "npm run clean && tsc && tsc-alias",
    "clean": "rimraf ./build",
    "copy-files": "cp -r ./src/presentation/wwwroot ./build/presentation/wwwroot",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.7.2",
    "@types/pino": "^7.0.4",
    "@types/pino-http": "^5.8.4",
    "@types/pino-pretty": "^4.7.5",
    "@types/socket.io": "^3.0.1",
    "@types/webpack-node-externals": "^3.0.4",
    "eslint": "^9.37.0",
    "eslint-plugin-perfectionist": "^4.15.1",
    "nodemon": "^3.1.10",
    "pino-pretty": "^13.1.2",
    "pino-webpack-plugin": "^2.0.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}

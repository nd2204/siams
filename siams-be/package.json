{
  "name": "siams-be",
  "version": "1.0.0",
  "description": "the backend for siams",
  "license": "MIT",
  "author": "nd2204",
  "type": "commonjs",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start:prod": "node --env-file ../.env build",
    "start:dev": "node --env-file ../.env build",
    "start": "npm run build && npm run start:prod",
    "dev": "nodemon --watch ./src --exec \"npm run build && npm run start:dev\"",
    "build": "npm run clean && tsc --build && tsc-alias",
    "clean": "rimraf ./build",
    "copy-files": "cp -r ./src/presentation/wwwroot ./build/presentation/wwwroot",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate:new": "db-migrate --sql-file -m src/infra/data/postgres/migrations --config src/infra/data/postgres/migrate.conf.json create ",
    "migrate:up": "db-migrate up -m src/infra/data/postgres/migrations --config src/infra/data/postgres/migrate.conf.json",
    "migrate:down": "db-migrate down -m src/infra/data/postgres/migrations --config src/infra/data/postgres/migrate.conf.json"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "csurf": "^1.2.2",
    "db-migrate": "^0.11.14",
    "db-migrate-pg": "^1.5.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "method-override": "^3.0.0",
    "mqtt": "^5.14.1",
    "pg": "^8.16.3",
    "pg-pool": "^3.10.1",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/csurf": "^1.11.5",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/method-override": "^3.0.0",
    "@types/mqtt": "^0.0.34",
    "@types/node": "^24.7.2",
    "@types/pg": "^8.15.5",
    "@types/pino": "^7.0.4",
    "@types/pino-http": "^5.8.4",
    "@types/pino-pretty": "^4.7.5",
    "@types/socket.io": "^3.0.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.37.0",
    "eslint-plugin-perfectionist": "^4.15.1",
    "nodemon": "^3.1.10",
    "pino-pretty": "^13.1.2",
    "pino-webpack-plugin": "^2.0.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "swagger-ui-express": "^5.0.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}

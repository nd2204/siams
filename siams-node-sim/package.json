{
  "name": "siams-node-sim",
  "version": "1.0.0",
  "description": "",
  "license": "MIT",
  "author": "nd2204",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "npm run build && node --env-file .env build/siams-node-sim/src",
    "dev": "nodemon --watch ./src --exec \"npm run start\"",
    "build": "npm run clean && tsc && tsc-alias && npm run postbuild",
    "postbuild": "ts-add-js-extension --dir build",
    "clean": "rimraf ./build",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "fullscreen-ink": "^0.1.0",
    "ink": "^6.3.1",
    "ink-cjs": "^4.4.1",
    "mqtt": "^5.14.1",
    "uuid": "^13.0.0",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.4",
    "@babel/plugin-transform-modules-commonjs": "^7.27.1",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@eslint/js": "^9.37.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/mqtt": "^0.0.34",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/yargs": "^17.0.33",
    "eslint": "^9.37.0",
    "eslint-plugin-perfectionist": "^4.15.1",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "react": "^19.2.0",
    "rimraf": "^6.0.1",
    "ts-add-js-extension": "^1.6.6",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
